# Product Scraper Agent Configuration
# Copy this to .env and adjust for your environment

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Bedrock Model Configuration
# Option 1: Use specific model ID
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Option 2: Use inference profile ARN (recommended for production)
# BEDROCK_INFERENCE_PROFILE_ARN=arn:aws:bedrock:us-east-1:ACCOUNT_ID:inference-profile/default

# Agent Configuration
AGENT_NAME=coe-product-scraper-agent
AGENT_VERSION=1.0.0
MAX_CONCURRENT_EXTRACTIONS=5

# Where to write the result JSON: local dir or S3 URI.
# Leave empty to return the result only in the response body.
OUTPUT_DESTINATION=./out
# OUTPUT_DESTINATION=s3://my-bucket/products/

# Logging
LOG_LEVEL=INFO

# Deployment
DOCKER_REGISTRY=ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com
DOCKER_IMAGE=coe-product-scraper-agent
DOCKER_TAG=latest
